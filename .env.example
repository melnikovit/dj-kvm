# Порты сервисов
DJKVM_PORT=8089
PROMETHEUS_PORT=9091
GRAFANA_PORT=3001

# Учетные записи
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-admin-pass
POSTGRES_PASSWORD=change-me-db-pass
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-pass

# Безопасность (сгенерируйте надежные случайные ключи)
JWT_SECRET=change-me-jwt-secret-key
DJKVM_SECRETS_KEY=change-me-secrets-key-32bytes!!

# Публичные URL (для работы из браузера)
PUBLIC_URL=http://127.0.0.1:8089
GRAFANA_URL=http://127.0.0.1:3001
PROMETHEUS_URL=http://127.0.0.1:9091
GRAFANA_ROOT_URL=http://127.0.0.1:3001

# Параметры агентов
AGENT_VERSION=auto
MAX_AGENTS=10000
